DATABASE_URL=postgres://kalkulacka:kalkulacka@localhost:5432/kalkulacka
# Veřejná adresa aplikace (odkazy v e-mailech)
APP_URL=http://localhost:3000
# SMTP (dev: Mailpit z docker-compose)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Kalkulačka schodů <no-reply@kalkulacka.local>"
# Produkce: první admin. Dokud v DB žádný admin není, dostane při startu pozvánku (heslo si nastaví sám).
# Neodejde-li e-mail, odkaz je v logu kontejneru (docker compose logs app).
ADMIN_EMAIL=
# Frontend: mock | http
NEXT_PUBLIC_API=http
